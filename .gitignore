outputs/paper/*.log
outputs/paper/*.out
outputs/paper/*.bbl
outputs/paper/*.blg
*.zip
*.7z
*.tar
*.tar.gz
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
Thumbs.db
outputs_backup/
