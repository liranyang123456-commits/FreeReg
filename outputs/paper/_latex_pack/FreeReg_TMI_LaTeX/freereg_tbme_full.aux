\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Photometric residual as an online validation signal on the airway (synthetic fly-through render from the real CT model). Left: the observed frame. Middle: residual heatmap of a hypothesized mis-registered pose (hot = large photometric error). Right: residual after FreeReg refinement, where the heatmap cools toward the noise floor as the pose is corrected. The render residual localizes registration error without labels (a 1\,mm pose offset drops silhouette IoU to 0.62 and a 2\,mm offset to 0.44, while refinement halves the photometric residual from 0.325 to 0.163), motivating its use as the co-anchored validation signal (Section~\ref {sec:render}).}}{8}{figure.5}\protected@file@percent }
\newlabel{fig:render}{{5}{8}{Photometric residual as an online validation signal on the airway (synthetic fly-through render from the real CT model). Left: the observed frame. Middle: residual heatmap of a hypothesized mis-registered pose (hot = large photometric error). Right: residual after FreeReg refinement, where the heatmap cools toward the noise floor as the pose is corrected. The render residual localizes registration error without labels (a 1\,mm pose offset drops silhouette IoU to 0.62 and a 2\,mm offset to 0.44, while refinement halves the photometric residual from 0.325 to 0.163), motivating its use as the co-anchored validation signal (Section~\ref {sec:render})}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Scene-graph multi-model occlusion compositing across two depth orderings. Three models (duck, ape, can) are placed front-to-back in different permutations (rows). For each, the real background (left), the ground-truth composite (middle), and our estimated composite (right) show the nearer model correctly hiding the farther one; the estimated composite reproduces the ground-truth occlusion ordering with 100\% occlusion-edge accuracy, since the depth-aware scene graph composites each model in the correct layer regardless of ordering.}}{8}{figure.6}\protected@file@percent }
\newlabel{fig:scene}{{6}{8}{Scene-graph multi-model occlusion compositing across two depth orderings. Three models (duck, ape, can) are placed front-to-back in different permutations (rows). For each, the real background (left), the ground-truth composite (middle), and our estimated composite (right) show the nearer model correctly hiding the farther one; the estimated composite reproduces the ground-truth occlusion ordering with 100\% occlusion-edge accuracy, since the depth-aware scene graph composites each model in the correct layer regardless of ordering}{figure.6}{}}
